# Copy to .env and edit.

# ---- Llama backend ----
# ollama = run Llama on this computer (free, private)   |   groq = hosted Llama (fast, needs key)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# GROQ_API_KEY=gsk_...

# General Llama model (chat, summary, Hindi translation)
LLM_MODEL=llama3.1:8b
# Specific model for prescription extraction + medical explanations.
# Leave empty to use LLM_MODEL, or set a medical Llama fine-tune you have pulled into Ollama.
MEDICAL_MODEL=
# Vision model for photos / scanned prescriptions
VISION_MODEL=llama3.2-vision

# For Groq use e.g.:
# LLM_MODEL=llama-3.3-70b-versatile
# VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

LLM_NUM_CTX=12288
LLM_TIMEOUT=300

# ---- Knowledge base ----
# faiss (local folder) | pinecone
VECTOR_STORE=faiss
# PINECONE_API_KEY=
# PINECONE_INDEX_NAME=medical-chatbot

# ---- Online trusted sources (openFDA, RxNorm, MedlinePlus) ----
ENABLE_ONLINE_SOURCES=true
# Optional, raises openFDA rate limits
# OPENFDA_API_KEY=
